#!/usr/bin/env node
// bt-relay — invoked by Claude Code hooks. Two responsibilities:
//   - watch mode: on UserPromptSubmit, emit hookSpecificOutput with the
//     host's recent transcript snapshot as additionalContext.
//   - host mode: on SessionEnd, trigger a teardown via `bt end`.
// Transcript ingest into the host server is handled by transcript-tailer,
// not by this hook — so this script does NOT POST events to the server.
// Always exits 0; errors go to a log file so they don't break the hook.

const fs = require('fs');
const path = require('path');
const { spawn } = require('child_process');
const state = require(path.join(__dirname, '..', 'server', 'state.js'));

const event = process.argv[2] || 'unknown';

let raw = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', c => raw += c);
process.stdin.on('end', main);
process.stdin.on('error', () => process.exit(0));

// Safety: don't hang the hook
setTimeout(() => process.exit(0), 4000);

async function main() {
  try {
    let s;
    try { s = state.read(); } catch (e) { s = { host: null, watch: null }; }

    // Watch mode: inject host context on UserPromptSubmit
    if (event === 'user_prompt' && s.watch && s.watch.context_file) {
      try {
        const txt = fs.readFileSync(s.watch.context_file, 'utf8');
        if (txt.trim()) {
          const slice = txt.length > 9500 ? txt.slice(-9500) : txt;
          process.stdout.write(JSON.stringify({
            hookSpecificOutput: {
              hookEventName: 'UserPromptSubmit',
              additionalContext: slice,
            },
          }));
        }
      } catch (e) { logErr(e); }
    }

    // SessionEnd: tear down host if active
    if (event === 'session_end' && s.host) {
      try {
        const btPath = path.join(__dirname, 'bt');
        spawn(process.execPath, [btPath, 'end'], {
          detached: true,
          stdio: 'ignore',
        }).unref();
      } catch (e) { logErr(e); }
    }

    process.exit(0);
  } catch (e) {
    logErr(e);
    process.exit(0);
  }
}

function logErr(e) {
  try {
    fs.mkdirSync(state.dataDir(), { recursive: true });
    fs.appendFileSync(
      path.join(state.dataDir(), 'relay-errors.log'),
      `${new Date().toISOString()} [${event}] ${e && (e.stack || e.message || e)}\n`,
    );
  } catch (_) { /* nothing more to do */ }
}
